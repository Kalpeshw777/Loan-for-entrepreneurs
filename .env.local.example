# Example Environment Variables for NIRVAAN
# Copy this file to .env.local and add your actual API keys.
# .env*.local files are git-ignored to prevent leaking secrets.

# Groq API Key (used for Groq-powered AI scheme recommendation & scheme chatbot)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Next.js public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
